<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body {
      font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f4f5;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 40px auto;
      background-color: #ffffff;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
      overflow: hidden;
    }
    .header {
      background-color: #18181b;
      padding: 24px;
      text-align: center;
    }
    .header h1 {
      color: #ffffff;
      margin: 0;
      font-size: 24px;
      font-weight: 600;
    }
    .content {
      padding: 32px 24px;
      text-align: center;
      color: #3f3f46;
    }
    .content p {
      font-size: 16px;
      line-height: 1.5;
      margin-bottom: 24px;
    }
    .otp-code {
      display: inline-block;
      font-size: 32px;
      font-weight: 700;
      color: #18181b;
      letter-spacing: 4px;
      padding: 16px 32px;
      background-color: #f4f4f5;
      border-radius: 8px;
      margin-bottom: 24px;
    }
    .footer {
      background-color: #f4f4f5;
      padding: 16px 24px;
      text-align: center;
      color: #71717a;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      {{#if logoUrl}}
      <img src="{{logoUrl}}" alt="{{appName}} Logo" style="max-height: 50px; margin-bottom: 16px;">
      {{/if}}
    </div>
    <div class="content">
      <p>Hello <strong>{{name}}</strong>,</p>
      <p>We received a request to log in to your <strong>{{appName}}</strong> account. Please use the following One-Time Password (OTP) to complete your login securely:</p>
      <div class="otp-code">{{otp}}</div>
      <p>This code is valid for the next 10 minutes. If you did not request this, please ignore this email.</p>
    </div>
    <div class="footer">
      &copy; {{year}} {{appName}}. All rights reserved.
    </div>
  </div>
</body>
</html>
